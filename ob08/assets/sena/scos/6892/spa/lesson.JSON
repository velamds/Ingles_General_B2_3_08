back": "Correct!"}}], "id": 10}, {"questions": [{"_data": [{"contents": [{"type": "pdf", "content": "engenn11le08ob08re7pdf01.pdf"}], "type": "question"}], "id": 0, "responses": [{"correct": 1, "id": 0, "_data": [{"type": "text", "content": ""}], "selected": 0}]}], "stimuli_ids": [], "template_override": 1, "type": "DWS", "_data": [{"contents": [{"type": "text", "content": " \nTaking things one step further.\n"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}, {"contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}], "type": "post_instructions"}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}], "id": 11}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "stimuli": [{"contents": [{}], "type": "welcome", "_data": [], "id": 0, "template_override": 1}, {"contents": [{"type": "slideshow", "value": {"images": [{"time": "0", "text": "", "id": 0, "image": "engenn11le08ob08re2img01.jpg"}, {"time": "100", "text": "Dear Beth,<br/><br/>How's life been treating you lately? You must be close to finishing your Law degree. I know that the family is really proud of what you have achieved.  Stop showing the rest of us up! Anyway, do you remember the girl I met through Margaret Vanderkamp, the matchmaker, a couple months ago? Well, she definitely has a knack for finding true love. Matchmaking is her business and I highly recommend her. She was able to connect me with the love of my life, Rhonda. She and I have been inseparable ever since our first date. She's gorgeous, talented and has a real zest for life. She laughs at my corny jokes and even thinks that my \u201cportly\u201d frame is adorable. Quite frankly, I am besotted with her. Don't be surprised if you get a wedding invitation in the mail before Christmas.", "id": 1, "image": "engenn11le08ob08re2img01.jpg"}, {"time": "58000", "text": "That being said\u2026 You and I are close, more like brother and sister than cousins. You've told me about past broken relationships and your non-existent social life. I understand that school has been your priority in the last couple years  but I think it's time to turn over a new leaf. Get back in the game and start dating. Better yet, why not leave it to the experts? Living your life without someone to share it with can be lonely. Give Margaret a chance of unearthing a hidden gem for you. Before you think of dismissing my idea, why don't you give me a call and we can chat about the process.\n<br/><br/>You deserve the same happiness in your personal life.\n<br/><br/>Your cousin,<br/><br/>Robert", "id": 2, "image": "engenn11le08ob08re2img03.jpg"}], "audiosrc": "engenn11le08ob08re2aud01", "coverimg": "engenn11le08ob08re2img01.jpg"}}], "id": 1, "template_override": 1, "type": "audio", "title": "", "_data": []}, {"contents": [], "id": 2, "template_override": 1, "type": "static", "title": "", "_data": []}, {"contents": [{"type": "video", "value": {"images": [{"time": "0", "text": "", "id": 0, "image": ""}, {"time": "5000", "text": "Writing An Informal Letter", "id": 1, "image": ""}, {"time": "22000", "text": "<span class = \"bullet\">What does Robert include in his informal letter?</span>", "id": 2, "image": ""}], "video_src": "engenn11le08ob08re3vid01"}}], "id": 3, "template_override": 1, "type": "video", "title": "", "_data": []}], "id": 0}]}