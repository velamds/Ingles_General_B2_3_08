": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": " If you and your boyfriend get that angry and hostile, sometimes you have to get rid of that ", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "id": 2}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "nagging.", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "If you don't clean your room and do the dishes when you are supposed to, your mother will start  ", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "id": 3}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "guff.", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "He says silly things and is really petty sometimes. Don't put up with his                                                  ", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "id": 4}], "type": "MT1", "id": 9, "stimuli_ids": []}, {"template_override": 1, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "type": "RSLT", "id": 10, "stimuli_ids": []}, {"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": " \nForm a few long sentences.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self-Assessment.\n", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}]}], "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn11le08ob04re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "type": "DWS", "id": 11, "stimuli_ids": []}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Difficult Relationships", "type": "lesson_name"}, {"content": "The Mediator", "type": "unit_name"}, {"content": 4, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 8, "type": "lesson"}, {"content": "B2.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Exchange information about unlikely events or fairly certain conditions that will be fulfilled in the present, past or future in spoken or written texts and in work and social contexts.", "type": "primary"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_2"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_3"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_4"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_7"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_8"}]}, {"content": "engenn11le08ob04re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Intonation in Non-Final Thought Groups", "type": "heading"}, {"content": " A thought group is a group of words that form a grammatical unit. It is often a phrase, clause or chunk of words that have a logical meaning. Each thought group can have its own intonation pattern.", "type": "describer"}, {"content": "When you say a long sentence, you break the sentence into smaller thought groups. This makes it easier for the listener to understand what you are saying.", "type": "text"}, {"content": " For example: <br/> <span class=\"italic\">Whenever I do my work,</span>//   <span class=\"italic\">I get sleepy</span>//   <span class=\"italic\">and then I don't finish</span>//   <span class=\"italic\">what I was supposed to have done</span>.", "type": "text"}, {"content": "As you read this sentence, your intonation should partially fall at the end of the each thought group, except for the final one, when your voice falls to indicate that you are finished. ", "type": "text"}, {"content": "Practice reading these sentences from the text:", "type": "text"}, {"content": "Regardless, he called his girlfriend to apologize, and to beg her forgiveness, but she refused to speak to him.", "type": "example"}, {"content": "We talked about how you are always so inconsiderate, how she always puts up with your guff, and how you always get on her nerves. ", "type": "example"}, {"content": "I asked her whether she was sick of your hostility, if she wanted to try to forget about you and whether she was certain that she wouldn't have any regrets.", "type": "example"}, {"content": "I asked her whether she would miss you, and if she still loved you despite all of the things you had done. ", "type": "example"}, {"content": "I asked her whether she wanted you to call her, if she had a message for you, and why she was so enraged.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Changing Emphasis", "type": "heading"}, {"content": " The way you order clauses and words within sentences can change the way the idea is presented and stressed. You can use these strategies to emphasize certain elements that you're trying to communicate. ", "type": "describer"}, {"content": "<span class=\"underline\">Passive constructions</span> change the way information is presented to the reader by changing the emphasis from who/what does the action in a sentence to who/what receives the action.  <br/><br/> <span class=\"italic\"><span class=\"strong\">New non-chemical cleaners</span> <span class=\"underline\">have been put out </span>by Acme. ", "type": "text"}, {"content": " <span class=\"underline\">Inversion</span> means that the natural word order of a sentence has been changed by placing a prepositional phrase before the verb, which places emphasis on it. In this type of construction, both the prepositional phrase and the verb are placed before the subject.  <br/><br/><span class=\"italic\"> Suddenly <span class=\"strong\">down</span> she fell! <br/> <span class=\"strong\">Across the pavement</span> went all of her books. </span>", "type": "text"}, {"content": " <span class=\"underline\">Fronting</span> means changing the natural order of a sentence so that a clause, other than the main clause, comes first. <br/><br/> <span class=\"italic\">He won't tell me where we are going. <br/> <span class=\"strong\">Where we are going</span>, he won't tell me. </span>", "type": "text"}, {"content": "<span class=\"underline\">Time phrases</span> go in different parts of a sentence. They are put first when the time is important in the context.  <br/><br/><span class=\"italic\"><span class=\"strong\"> At midnight</span>, all of the bells began to ring.", "type": "text"}, {"content": "<span class=\"underline\">What clauses </span><br/>  What clauses commonly have verbs such as  <span class=\"italic\">need</span>,  <span class=\"italic\">want</span>,  <span class=\"italic\">like</span>,  <span class=\"italic\">hate</span> in them. <br/><br/>  <span class=\"italic\">I hate the snow. <br/> <span class=\"strong\">What I hate is</span> the snow.<br/> You need a vacation. <br/> <span class=\"strong\">What you need is</span> a vacation.</span>", "type": "text"}, {"content": "What exactly the cause of the problem was, he did not know.", "type": "example"}, {"content": "It seemed as though all possible options had been exhausted.", "type": "example"}, {"content": "What she hates most is your constant nagging.", "type": "example"}, {"content": "As to where all of this animosity is coming from, she could not say.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "forgiveness", "type": "name"}, {"content": "stopping one's feelings of anger or resentment", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Regardless, he called Elizabeth to apologize, and to beg her forgiveness.", "type": "example"}, {"content": "engenn11le08ob04aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about relationship problems.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "guff", "type": "name"}, {"content": " trivial, worthless, or insolent talk or ideas", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We talked about how you are always so inconsiderate, how she always puts up with your guff, and how you always get on her nerves.", "type": "example"}, {"content": "engenn11le08ob04aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to get on one's nerves ", "type": "name"}, {"content": "to irritate or annoy someone", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: We talked about how you are always so inconsiderate, how she always puts up with your guff, and how you always get on her nerves.", "type": "example"}, {"content": "engenn11le08ob04aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to nag", "type": "name"}, {"content": "to persistently find fault or continuously urge ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: What she hates most is your constant nagging. ", "type": "example"}, {"content": "engenn11le08ob04aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "animosity", "type": "name"}, {"content": "strong hostility", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: As to where all of this animosity is coming from, she could not say.", "type": "example"}, {"content": "engenn11le08ob04aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "enraged", "type": "name"}, {"content": "very angry; furious", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I asked her whether she wanted you to call her, if she had a message for you, and why she was so enraged. ", "type": "example"}, {"content": "engenn11le08ob04aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "hostility ", "type": "name"}, {"content": "unfriendliness or opposition", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I asked her whether she was sick of your hostility.", "type": "example"}, {"content": "engenn11le08ob04aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "inconsiderate ", "type": "name"}, {"content": "thoughtless", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: We talked about how you are always so inconsiderate.", "type": "example"}, {"content": "engenn11le08ob04aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Make a chart with four headings: weekend plans, groceries, favorite activities, and household chores. ", "type": "text"}, {"content": "Under each heading, write at least five things that correspond with that category.", "type": "text"}, {"content": "Convert each heading into a long sentence (e.g. This weekend, I will go to the park, go shopping, eat a hamburger and watch TV.)", "type": "text"}, {"content": "Practice saying the sentences with a partner, focusing on intonation.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I make lists containing at least five items.", "type": "text"}, {"content": "I convert each list into a sentence.", "type": "text"}, {"content": "I practice using proper intonation.", "type": "text"}]}]}